generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  category    String
  image       String?  // Add this
  stock       Int      @default(0) // Add this
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model AdminProfile {
  id               String   @id @default("main")
  displayName      String   @default("Kirubel Adisu")
  image            String?
  mfaEnabled       Boolean  @default(true)
  apiKeyRotatedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  displayName   String
  passwordHash  String
  mfaEnabled    Boolean  @default(false)
  mfaSecret     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id        String   @id @default(cuid())
  total     Float
  status    String   @default("PENDING")
  items     Json
  createdAt DateTime @default(now())
}
